#!/usr/bin/env bash
# Prospect: Stomper. If the pushed commits passed the local checks
# (Tools/_PS/stomper/stomper.py), post a "Stomper" commit status on GitHub
# after the push. This runs in the background and never blocks the push.

gitroot=$(git rev-parse --show-toplevel)
script="$gitroot/Tools/_PS/stomper/stomper.py"
[ -f "$script" ] || exit 0

zero="0000000000000000000000000000000000000000"
shas=()
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    shas+=("$local_sha")
done
[ ${#shas[@]} -eq 0 ] && exit 0

if [[ $(uname) == MINGW* || $(uname) == CYGWIN* ]]; then
    py=(py -3)
else
    py=(python3)
fi

# $2 is the remote URL. $PPID is the `git push` process; the poster waits for it to exit.
"${py[@]}" "$script" hook "$2" "$PPID" "${shas[@]}" || true
exit 0
